# Development Environment Configuration File
# Purpose: Store credentials and URLs for local development testing
# Change: Created to enable environment-specific test configuration

# CHANGE: Set environment name
# Reason: Tell Playwright to load .env.dev instead of .env.staging or .env.prod
# Impact: Tests run against localhost development server
ENV=dev

# CHANGE: Set backend base URL
# Reason: Point API requests to local development server
# Problem Solved: Tests don't need to hard-code base URL
# Impact: Can change backend port without modifying test code
BASE_URL=http://localhost:8000

# CHANGE: Development API key placeholder
# Reason: For future use if endpoints require API authentication
# Note: Currently not used by test endpoints
DEV_API_KEY=your_dev_api_key

# CHANGE: Development token placeholder
# Reason: For future token-based authentication
# Note: Backend uses cookie-based auth currently
DEV_TOKEN=your_dev_token