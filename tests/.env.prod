# Production Environment Configuration File
# Purpose: Store credentials and URLs for production validation
# Change: Created for post-deployment smoke testing and monitoring

# CHANGE: Set environment name
# Reason: Tell Playwright to load .env.prod for production tests
# Impact: Tests run against live production API
ENV=prod

# CHANGE: Set production server base URL
# Reason: Point API requests to production API endpoint
# Problem Solved: Validate critical functionality on live system
# Impact: Enables production smoke testing and quick issue detection
BASE_URL=https://api.example.com

# CHANGE: Production API key
# Reason: Authenticate requests to production API if needed
# WARNING: Keep secret - never commit real credentials to repository
# Note: Use in CI/CD secrets, not in versioned files
PROD_API_KEY=your_prod_api_key

# CHANGE: Production token
# Reason: Token-based authentication for production
# WARNING: Keep secret - store in secure CI/CD environment
# Note: Update with actual production credentials
PROD_TOKEN=your_prod_token