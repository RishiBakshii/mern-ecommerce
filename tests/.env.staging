# Staging Environment Configuration File
# Purpose: Store credentials and URLs for pre-production testing
# Change: Created for QA and staging validation before production release

# CHANGE: Set environment name
# Reason: Tell Playwright to load .env.staging for staging tests
# Impact: Tests run against staging server matching production
ENV=staging

# CHANGE: Set staging server base URL
# Reason: Point API requests to staging API endpoint
# Problem Solved: Validate fixes in production-like environment
# Impact: CI/CD can test against staging before production deployment
BASE_URL=https://staging-api.example.com

# CHANGE: Staging API key
# Reason: Authenticate requests to staging API if needed
# Note: Update with actual staging API key
STAGING_API_KEY=your_staging_api_key

# CHANGE: Staging token
# Reason: Token-based authentication for staging
# Note: Update with actual staging token
STAGING_TOKEN=your_staging_token